{
  "schemaVersion": 1,
  "id": "miseriae.display-refresh",
  "name": "Display Refresh",
  "version": "1.0.0",
  "author": "miseriae",
  "license": "MIT",
  "description": "Quick 60/120 Hz switch for an external display in the Omarchy bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Display Refresh",
    "description": "Toggle a display between two refresh rates (default 120/60 Hz).",
    "category": "System",
    "aliases": [
      "display",
      "monitor",
      "refresh",
      "hz",
      "120",
      "60"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "output": "HDMI-A-1",
      "highRate": 120,
      "lowRate": 60,
      "pollInterval": 2,
      "showIcon": true
    },
    "schema": [
      {
        "key": "output",
        "type": "string",
        "label": "Output name",
        "defaultValue": "HDMI-A-1",
        "description": "Hyprland output name, e.g. HDMI-A-1."
      },
      {
        "key": "highRate",
        "type": "integer",
        "label": "High refresh (Hz)",
        "min": 30,
        "max": 240,
        "step": 1,
        "defaultValue": 120
      },
      {
        "key": "lowRate",
        "type": "integer",
        "label": "Low refresh (Hz)",
        "min": 30,
        "max": 240,
        "step": 1,
        "defaultValue": 60
      },
      {
        "key": "pollInterval",
        "type": "integer",
        "label": "Refresh interval (s)",
        "description": "How often the monitor state is checked.",
        "min": 1,
        "max": 60,
        "step": 1,
        "defaultValue": 2
      },
      {
        "key": "showIcon",
        "type": "boolean",
        "label": "Show display icon",
        "defaultValue": true
      }
    ]
  }
}
